# Copy to .env and fill in every value. Never commit .env.
# Generate random secrets with: openssl rand -hex 32

# Bearer token clients must send to the MCP server (Authorization: Bearer <token>), >= 32 chars.
MCP_AUTH_TOKEN=

# PostgreSQL credentials used by SonarQube.
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=

# SonarQube token for the scanner. After the first `docker compose up`, open
# http://127.0.0.1:9000, change the admin password, then create a token under
# My Account > Security (type: Global Analysis Token) and paste it here.
SONAR_TOKEN=

# API key for the OWASP ZAP daemon.
ZAP_API_KEY=

# Optional
# IMAGE_TAG=local
# LOG_LEVEL=info
# MCP_PORT=3000
# SONAR_PORT=9000
# ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:stable
# Source tree mounted read-only into the scanner at /workspace/src
# SCAN_SOURCE=./test-samples
# uid:gid that owns ./security-reports on the host
# SCAN_UID=1000
# SCAN_GID=1000
