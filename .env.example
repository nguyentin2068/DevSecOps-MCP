# Copy to .env and adjust. Never commit .env. Scanner-only use needs no .env at all.
# Generate random secrets with: openssl rand -hex 32

# Only for the optional MCP server (docker compose --profile mcp up -d mcp): the bearer token
# clients send (Authorization: Bearer <token>), >= 32 chars. The server refuses to start without it.
MCP_AUTH_TOKEN=

# Optional
# IMAGE_TAG=local
# LOG_LEVEL=info
# MCP_PORT=3000
# Source tree mounted read-only into the scanner at /workspace/src
# SCAN_SOURCE=./test-samples
# uid:gid that owns ./security-reports on the host
# SCAN_UID=1000
# SCAN_GID=1000
