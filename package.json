{
  "name": "devsecops-mcp-server",
  "version": "2.0.0",
  "description": "Self-hosted DevSecOps scan runner for Jenkins (Opengrep, OSV-Scanner, Trivy, Katana + Nuclei) with a read-only MCP server for AI triage",
  "main": "dist/src/mcp/server.js",
  "bin": {
    "devsecops-scan": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint src tests",
    "test": "jest",
    "start": "node dist/src/mcp/server.js",
    "start:mcp": "npm run build && npm start",
    "dev": "ts-node src/mcp/server.ts",
    "scan": "node dist/src/cli.js",
    "security:scan": "npm audit --audit-level high"
  },
  "keywords": [
    "mcp",
    "devsecops",
    "security",
    "sast",
    "dast",
    "sca",
    "opengrep",
    "osv-scanner",
    "trivy",
    "nuclei",
    "katana",
    "jenkins",
    "kubernetes"
  ],
  "author": "jmstar85",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "winston": "^3.17.0",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.1",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
